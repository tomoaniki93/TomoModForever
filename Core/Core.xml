<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
    <!-- Core, in load order. -->
    <Script file="Utils.lua" />
    <!-- WoW: Forever look shared by the chat, minimap, info panel and meter (1.3.9) -->
    <Script file="ForeverChrome.lua" />
    <!-- Client flavour gate. Loads before Database.lua because it patches the -->
    <!-- defaults, and before every module because each blocked module file -->
    <!-- opens with a guard that reads it. -->
    <Script file="Compat.lua" />
    <Script file="Forge\Forge.lua" />
    <Script file="Forge\ForgeIO.lua" />
    <Script file="Forge\ForgeText.lua" />
    <Script file="Forge\ForgeEdit.lua" />
    <Script file="Forge\ForgeRegistry.lua" />
    <Script file="Forge\ForgeCanvas.lua" />
    <Script file="Forge\ForgeAssets.lua" />
    <Script file="Forge\ForgeSchema.lua" />
    <Script file="Database.lua" />
    <!-- Module inventory: the engine, then the manifests that populate it. -->
    <!-- Both must load after Database.lua - the manifests are validated -->
    <!-- against TomoMod_Defaults - and before Profiles.lua, which will read -->
    <!-- the inventory for selective import. -->
    <Script file="ModuleRegistry.lua" />
    <Script file="ModuleManifest.lua" />
    <Script file="ModuleLifecycle.lua" />
    <Script file="ModuleReloadUI.lua" />
    <Script file="LayoutEngine.lua" />
    <Script file="LayoutV41.lua" />
    <Script file="ResolutionPresets.lua" />
    <Script file="ProfileSafety.lua" />
    <Script file="LayoutShare.lua" />
    <Script file="Profiles.lua" />
    <Script file="ContextProfiles.lua" />
    <Script file="SelectiveImport.lua" />
    <Script file="WhatsNew.lua" />
    <Script file="Init.lua" />
    <!-- Config UI: moved to the TomoModForever_Options sub-addon (LoadOnDemand). -->
    <!-- OptionsLoader pulls it in on first use. -->
    <Script file="OptionsLoader.lua" />
    <!-- TUI compatibility layer (must load before any ported TUI module) -->
    <Include file="TuiCompat\TuiCompat.xml" />
</Ui>
