## =====================
## Core
## =====================
Core\Utils.lua
## Client flavour gate. Loads before Database.lua because it patches the
## defaults, and before every module because each blocked module file
## opens with a guard that reads it.
Core\Compat.lua
Core\Forge\Forge.lua
Core\Forge\ForgeIO.lua
Core\Forge\ForgeText.lua
Core\Forge\ForgeEdit.lua
Core\Forge\ForgeRegistry.lua
Core\Forge\ForgeCanvas.lua
Core\Forge\ForgeAssets.lua
Core\Forge\ForgeSchema.lua
Core\Database.lua
## Module inventory: the engine, then the manifests that populate it.
## Both must load after Database.lua -- the manifests are validated
## against TomoMod_Defaults -- and before Profiles.lua, which will read
## the inventory for selective import.
Core\ModuleRegistry.lua
Core\ModuleManifest.lua
Core\ModuleLifecycle.lua
Core\ModuleReloadUI.lua
Core\LayoutEngine.lua
Core\LayoutV41.lua
Core\ResolutionPresets.lua
Core\ProfileSafety.lua
Core\LayoutShare.lua
Core\Profiles.lua
Core\ContextProfiles.lua
Core\SelectiveImport.lua
Core\WhatsNew.lua
Core\Init.lua

## =====================
## Config UI
## =====================
## Moved to the TomoMod_Options sub-addon (## LoadOnDemand: 1) -- 28 files,
## ~17900 lines that most sessions never open. Core/OptionsLoader.lua pulls
## it in on first use.
Core\OptionsLoader.lua

## =====================
## TUI compatibility layer (must load before any ported TUI module)
Core\TuiCompat\TuiCompat.xml

